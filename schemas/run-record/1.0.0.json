{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secure-home:contract:run-record:1.0.0",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "run-record" },
    "contract_version": { "type": "string", "const": "1.0.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "digest": { "$ref": "#/$defs/__schema0" }
      },
      "required": ["name", "version", "digest"],
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "terminal_state": { "type": "string", "const": "COMPLETED" } },
          "required": ["terminal_state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terminal_state": { "type": "string", "const": "REFUSED" },
            "failure": {
              "type": "object",
              "properties": {
                "class": { "type": "string", "const": "contract_refusal" },
                "detail": { "type": "string", "minLength": 1 }
              },
              "required": ["class", "detail"],
              "additionalProperties": false
            }
          },
          "required": ["terminal_state", "failure"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terminal_state": { "type": "string", "const": "OPERATIONAL_FAILURE" },
            "failure": {
              "type": "object",
              "properties": {
                "class": { "type": "string", "const": "operational" },
                "detail": { "type": "string", "minLength": 1 }
              },
              "required": ["class", "detail"],
              "additionalProperties": false
            }
          },
          "required": ["terminal_state", "failure"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terminal_state": { "type": "string", "const": "CANCELLED" },
            "detail": { "type": "string", "minLength": 1 }
          },
          "required": ["terminal_state", "detail"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terminal_state": { "type": "string", "const": "TIMED_OUT" },
            "detail": { "type": "string", "minLength": 1 }
          },
          "required": ["terminal_state", "detail"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "terminal_state": { "type": "string", "const": "INDETERMINATE" },
            "detail": { "type": "string", "minLength": 1 }
          },
          "required": ["terminal_state", "detail"],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": { "bundle_digest": { "$ref": "#/$defs/__schema0" } },
      "required": ["bundle_digest"],
      "additionalProperties": false
    }
  },
  "required": ["contract_id", "contract_version", "run_id", "profile", "outcome", "evidence"],
  "additionalProperties": false,
  "$defs": { "__schema0": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
