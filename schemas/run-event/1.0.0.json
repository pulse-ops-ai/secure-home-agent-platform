{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secure-home:contract:run-event:1.0.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "run.started" },
        "profile": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
            },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "required": ["name", "version", "digest"],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type",
        "profile"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "capability.granted" },
        "grant": {
          "type": "object",
          "properties": {
            "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "mounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": { "type": "string", "pattern": "^\\/" },
                  "posture": { "type": "string", "enum": ["read_only", "read_write"] }
                },
                "required": ["path", "posture"],
                "additionalProperties": false
              }
            },
            "network": {
              "type": "object",
              "properties": {
                "default": { "type": "string", "const": "deny" },
                "granted_destinations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "host": {
                        "type": "string",
                        "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
                      },
                      "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                    },
                    "required": ["host", "port"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["default", "granted_destinations"],
              "additionalProperties": false
            },
            "credentials": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
                "required": ["env_var"],
                "additionalProperties": false
              }
            }
          },
          "required": ["tools", "mounts", "network", "credentials"],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type",
        "grant"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "call.attempted" },
        "call_id": { "$ref": "#/$defs/__schema9" },
        "operation": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type",
        "call_id",
        "operation"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "call.disposition" },
        "call_id": { "$ref": "#/$defs/__schema9" },
        "disposition": { "type": "string", "enum": ["permitted", "denied"] },
        "detail": { "type": "string", "minLength": 1 }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type",
        "call_id",
        "disposition"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "adapter.started" }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "adapter.completed" }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "contract_id": { "$ref": "#/$defs/__schema0" },
        "contract_version": { "$ref": "#/$defs/__schema1" },
        "run_id": { "$ref": "#/$defs/__schema2" },
        "sequence": { "$ref": "#/$defs/__schema3" },
        "timestamp": { "$ref": "#/$defs/__schema4" },
        "adapter": { "$ref": "#/$defs/__schema5" },
        "provider": { "$ref": "#/$defs/__schema6" },
        "provider_event_name": { "$ref": "#/$defs/__schema7" },
        "provider_metadata": { "$ref": "#/$defs/__schema8" },
        "event_type": { "type": "string", "const": "run.terminated" },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "properties": { "terminal_state": { "type": "string", "const": "COMPLETED" } },
              "required": ["terminal_state"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "terminal_state": { "type": "string", "const": "REFUSED" },
                "failure": {
                  "type": "object",
                  "properties": {
                    "class": { "type": "string", "const": "contract_refusal" },
                    "detail": { "type": "string", "minLength": 1 }
                  },
                  "required": ["class", "detail"],
                  "additionalProperties": false
                }
              },
              "required": ["terminal_state", "failure"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "terminal_state": { "type": "string", "const": "OPERATIONAL_FAILURE" },
                "failure": {
                  "type": "object",
                  "properties": {
                    "class": { "type": "string", "const": "operational" },
                    "detail": { "type": "string", "minLength": 1 }
                  },
                  "required": ["class", "detail"],
                  "additionalProperties": false
                }
              },
              "required": ["terminal_state", "failure"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "terminal_state": { "type": "string", "const": "CANCELLED" },
                "detail": { "type": "string", "minLength": 1 }
              },
              "required": ["terminal_state", "detail"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "terminal_state": { "type": "string", "const": "TIMED_OUT" },
                "detail": { "type": "string", "minLength": 1 }
              },
              "required": ["terminal_state", "detail"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "terminal_state": { "type": "string", "const": "INDETERMINATE" },
                "detail": { "type": "string", "minLength": 1 }
              },
              "required": ["terminal_state", "detail"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "contract_id",
        "contract_version",
        "run_id",
        "sequence",
        "timestamp",
        "adapter",
        "event_type",
        "outcome"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": { "type": "string", "const": "run-event" },
    "__schema1": { "type": "string", "const": "1.0.0" },
    "__schema2": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "__schema3": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "__schema5": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "__schema6": { "type": "string", "minLength": 1 },
    "__schema7": { "type": "string", "minLength": 1 },
    "__schema8": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {}
    },
    "__schema9": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" }
  }
}
