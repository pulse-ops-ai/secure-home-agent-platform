{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secure-home:contract:run-event:1.0.0",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "run-event" },
    "contract_version": { "type": "string", "const": "1.0.0" },
    "event_type": {
      "type": "string",
      "enum": [
        "run.started",
        "capability.granted",
        "call.attempted",
        "call.disposition",
        "adapter.started",
        "adapter.completed",
        "run.terminated"
      ]
    },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "provider": { "type": "string", "minLength": 1 },
    "provider_event_name": { "type": "string", "minLength": 1 },
    "provider_metadata": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {}
    },
    "grant": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "pattern": "^\\/" },
              "posture": { "type": "string", "enum": ["read_only", "read_write"] }
            },
            "required": ["path", "posture"],
            "additionalProperties": false
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "default": { "type": "string", "const": "deny" },
            "granted_destinations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$" },
                  "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                },
                "required": ["host", "port"],
                "additionalProperties": false
              }
            }
          },
          "required": ["default", "granted_destinations"],
          "additionalProperties": false
        },
        "credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
            "required": ["env_var"],
            "additionalProperties": false
          }
        }
      },
      "required": ["tools", "mounts", "network", "credentials"],
      "additionalProperties": false
    },
    "detail": { "type": "string", "minLength": 1 }
  },
  "required": [
    "contract_id",
    "contract_version",
    "event_type",
    "run_id",
    "sequence",
    "timestamp",
    "adapter"
  ],
  "additionalProperties": false
}
