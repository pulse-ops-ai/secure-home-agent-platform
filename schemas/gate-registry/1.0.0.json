{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:secure-home:contract:gate-registry:1.0.0",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "gate-registry" },
    "contract_version": { "type": "string", "const": "1.0.0" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "timeout_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "max_output_bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "environment_names": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
          },
          "network": { "type": "string", "const": "none" }
        },
        "required": [
          "id",
          "executable",
          "args",
          "timeout_seconds",
          "max_output_bytes",
          "environment_names",
          "network"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["contract_id", "contract_version", "gates"],
  "additionalProperties": false
}
