{
  "name": "@secure-home/eslint-config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint flat configuration for the workspace.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./node": "./node.js",
    "./library": "./library.js",
    "./service": "./service.js",
    "./application": "./application.js",
    "./test": "./test.js"
  },
  "files": [
    "index.js",
    "base.js",
    "node.js",
    "library.js",
    "service.js",
    "application.js",
    "test.js"
  ],
  "scripts": {
    "lint": "secure-home-lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node -e \"console.log('no build: config-only package, published as-is')\""
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@secure-home/lint-config": "workspace:*",
    "@secure-home/testing": "workspace:*",
    "@secure-home/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
