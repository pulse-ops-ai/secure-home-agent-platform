{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": [
    "Strict, modern defaults for Node 24 + ESM. Every consumer inherits these;",
    "a member that must relax one states why in its own tsconfig rather than",
    "changing this file.",
    "",
    "Each strictness flag below is a deliberate decision, not a default sweep.",
    "See packages/tsconfig/README.md for the rationale and the two documented",
    "consequences (process.env indexing, and NestJS decorator support)."
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "noEmitOnError": true
  },
  "exclude": ["${configDir}/dist", "${configDir}/node_modules", "${configDir}/coverage"]
}
