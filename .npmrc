# pnpm configuration for the TypeScript workspace.
#
# The pnpm version itself is pinned by the "packageManager" field in
# package.json and provisioned by Corepack — do not pin it here as well.

# Fail rather than silently running on an unsupported Node.
engine-strict=true

# Deterministic manifests: no caret ranges introduced by `pnpm add`.
save-exact=true

# Workspace packages resolve to the local source, not the registry.
link-workspace-packages=true
prefer-workspace-packages=true
