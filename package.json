{
  "name": "secure-home-agent-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, security-first household agent platform — TypeScript workspace root.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "affected": "node scripts/affected-targets.mjs",
    "build": "pnpm -r --if-present run build",
    "check": "bash scripts/check.sh",
    "check:scaffold": "bash scripts/validate-scaffold.sh",
    "check:imports": "node scripts/check-source-imports.mjs",
    "check:knowledge": "node scripts/check-knowledge.mjs",
    "check:secrets": "bash scripts/scan-secrets.sh",
    "check:workspace": "node scripts/check-workspace.mjs",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:format": "syncpack format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "syncpack": "catalog:",
    "typescript": "catalog:"
  }
}
